# Binance API Keys (Get from https://www.binance.com/account/login)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Discord Webhook (Optional - Get from Discord Server Settings)
DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/your_webhook_url

# Telegram (Optional - Get from BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Alerts (Optional)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_PASSWORD=your_app_password_here
RECIPIENT_EMAIL=recipient@gmail.com
